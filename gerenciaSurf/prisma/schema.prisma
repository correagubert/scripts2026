generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url = "mysql://root:senai@localhost:3306/crudPranchas"
}

//referencia
model prancha {
  id                  Int       @id @default(autoincrement())
  modelo                String    @db.VarChar(100)
  marca             String       
  tabua               String
  tamanho          String
  material                 String

  @@map("prancha")
}